    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
      propertyPath: conds.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
      propertyPath: conds.Array.data[0].name
      value: 0. Begone anchorless animal...
      objectReference: {fileID: 0}
    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
      propertyPath: conds.Array.data[1].name
      value: 1. It's been ages since I've felt Juliet's warmth... I should text her...
      objectReference: {fileID: 0}
    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
      propertyPath: conds.Array.data[2].name
      value: 2. Go forth, my message!
      objectReference: {fileID: 0}
    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
      propertyPath: conds.Array.data[3].name
      value: 3. I must send this message, yet I cannot; <var>oceanRomeoReason</var>
      objectReference: {fileID: 0}
    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
      propertyPath: conds.Array.data[4].name
      value: 4. May that message reach Juliet before sinking.
      objectReference: {fileID: 0}
    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
      propertyPath: conds.Array.data[5].name
      value: 5. Stop looking at that tablet, help me!
      objectReference: {fileID: 0}
    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
      propertyPath: conds.Array.data[6].name
      value: 6. Juliet, give me a sign!
      objectReference: {fileID: 0}
    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
