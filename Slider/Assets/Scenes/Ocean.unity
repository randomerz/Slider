      propertyPath: dconds.Array.data[0].dialogueChain.Array.data[0].dialogue
      value: "I\u2026 am Chad! And the credit for returning this flashlight is mine!"
      objectReference: {fileID: 0}
    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
      propertyPath: dconds.Array.data[0].dialogueChain.Array.data[1].dialogue
      value: Up here, short stuff. Ha! You can't even jump.
      objectReference: {fileID: 0}
    - target: {fileID: 3652435011426292518, guid: eb8cd11432469439eb214403b87b5b92, type: 3}
      propertyPath: dconds.Array.data[0].dialogueChain.Array.data[2].dialogue
